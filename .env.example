# Database Configuration
MONGO_URL=mongodb://127.0.0.1:27017/PropertyHubDB
# For MongoDB Atlas, use: mongodb+srv://username:password@cluster.mongodb.net/wanderlust

# Cloudinary Configuration (for image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Stripe Configuration (for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Session Configuration
SESSION_SECRET=your_super_secret_session_key_here

# Optional: Port configuration (defaults to 8080)
PORT=8080

# Note: Email configuration is currently hardcoded in public/js/mail.js
# For production, consider moving email credentials here:
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_specific_password