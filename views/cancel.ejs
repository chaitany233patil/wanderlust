<% layout('layout/boilerplate')%>
    <style>
      body {
        background-color: #f8d7da;
      }
      .card {
        margin: 100px auto;
        max-width: 400px;
        padding: 20px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        border: none;
        border-radius: 10px;
        background-color: #fff;
      }
      .warning-icon {
        font-size: 50px;
        color: #dc3545;
      }
      .btn-custom {
        width: 100%;
        padding: 10px;
        font-size: 18px;
      }
    </style>
  </head>
  <body>
    <div class="card text-center">
      <div class="mb-4">
        <span class="warning-icon">⚠️</span>
      </div>
      <h2 class="mb-3">Payment Canceled</h2>
      <p class="text-muted mb-4">
        You have canceled the payment. Please try again if you wish to book.
      </p>
      <form method="get" action="/listings">
        <button type="submit" class="btn btn-success btn-custom">
          Go Back to Home
        </button>
      </form>
    </div>
  </body>
</html>
