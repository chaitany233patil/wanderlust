<% layout('layout/boilerplate')%>
<style>
  * {
    font-family: "Work Sans", sans-serif;
  }

  .listing-title {
    width: 80%;
    margin: 0 auto;
    margin-top: 80px;
  }

  .title {
    font-weight: 600;
    font-size: 28px;
    margin: 0;
    margin-bottom: 20px;
  }

  .property-info {
    /* height: 800px; */
    width: 85%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    /* padding-bottom: 50px; */
  }

  .property-images {
    /* height: 50%; */
    flex: 1;
    display: flex;
  }

  .property-images .col1 {
    /* height: 100%; */
    height: 500px;
    flex: 1.5;
    background-image: url("<%= listing.images[0].url %>");
    background-size: cover;
    background-position: center;
    margin-right: 8px;
    border-radius: 10px;
  }

  .property-images .col2 {
    flex: 1;
    /* height: 100%; */
    height: 500px;
    display: flex;
    flex-direction: column;
  }

  .property-images .col2 .image-one {
    /* height: 100%; */
    flex: 1;
    background-image: url("<%= listing.images[1].url %>");
    background-size: cover;
    background-position: center;
    margin-bottom: 8px;
    border-radius: 10px;
  }

  .property-images .col2 .image-two {
    height: 100%;
    flex: 1;
    background-image: url("<%= listing.images[2].url %>");
    background-size: cover;
    background-position: center;
    border-radius: 10px;
  }

  .property-description {
    /* height: 30%; */
    margin-top: 10px;
    margin-bottom: 60px;
    position: relative;
  }

  .listing-desc {
    font-size: x-large;
    font-weight: 600;
    width: 56%;
  }

  .listing-loc {
    font-size: 20px;
  }

  .property-booking {
    height: 230px; /* Reduced height */
    width: 420px; /* Reduced width */
    border-style: solid;
    border-width: 1px;
    border-color: rgba(158, 155, 155, 0.5);
    position: absolute;
    right: 20px;
    top: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    padding: 0 10px;
    padding-bottom: 20px;
  }

  .date-selection {
    display: flex;
    flex-direction: column;
    gap: 20px; /* Reduced gap */
    width: 100%;
    margin-top: -20px;
  }

  .date-input {
    width: 100%;
    padding: 5px;
    font-size: 14px; /* Reduced font size */
    border: 1px solid #ccc;
    border-radius: 5px;
  }

  .buy-btn {
    border: none;
    padding: 5px 20px; /* Reduced padding */
    border-radius: 10px;
    background-color: rgb(255, 56, 92);
    font-size: 16px; /* Reduced font size */
    font-weight: 600;
    color: white;
    margin-top: 30px;
    cursor: pointer;
    width: 90%;
    margin-top: 10px;
    font-size: 20px;
  }

  .rent-price {
    margin-top: 5px;
    padding: 10px;
    font-size: 25px;
    font-weight: 500;
  }

  .owner-info {
    width: 50%;
    border-top: 1px solid rgba(167, 164, 164, 0.576);
    border-bottom: 1px solid rgba(167, 164, 164, 0.576);
    display: flex;
    flex-direction: column;
  }

  .owner-name {
    margin: 0;
    margin-top: 10px;
    font-size: 20px;
    font-weight: 600;
  }

  .owner-status {
    margin: 0;
    margin-top: 3px;
    margin-bottom: 10px;
  }

  .owner-desc {
    flex: 1;
  }

  .edt-dlt {
    padding: 10px 0;
    display: flex;
    align-items: center;
  }

  .edt-btn,
  .dlt-btn {
    padding: 2px 20px;
    font-size: 18px;
    border: none;
    background-color: rgb(255, 56, 92);
    color: white;
    margin-right: 20px;
    border-radius: 5px;
  }

  .dlt-btn {
    background-color: black;
  }

  .bt-border {
    height: 10px;
    border-bottom: 1px solid rgba(151, 147, 147, 0.744);
    width: 86%;
    margin: 0 auto;
  }

  .map-rating {
    width: 86%;
    margin: 0 auto;
    margin-top: 10px;
    display: flex;
  }

  .allReviews {
    width: 86%;
    margin: 0 auto;
  }

  #map {
    height: 400px;
    width: 500px;
    z-index: 10;
  }

  .rtng-section {
    height: 400px;
    flex: 1;
    width: 200px;
  }

  /* rating */
  .starability-result {
    position: relative;
    width: 150px;
    height: 30px;
    background-image: url("data:image/png;base64,");
    font-size: 0.1em;
    color: transparent;
  }

  .starability-result:after {
    content: " ";
    position: absolute;
    left: 0;
    height: 30px;
    background-image: url("data:image/png;base64,");
    background-position: 0 -30px;
  }

  .starability-result[data-rating="5"]::after {
    width: 150px;
  }

  .starability-result[data-rating="4"]::after {
    width: 120px;
  }

  .starability-result[data-rating="3"]::after {
    width: 90px;
  }

  .starability-result[data-rating="2"]::after {
    width: 60px;
  }

  .starability-result[data-rating="1"]::after {
    width: 30px;
  }

  @media screen and (-webkit-min-device-pixel-ratio: 2),
    screen and (min-resolution: 192dpi) {
    .starability-result {
      background-image: url("data:image/png;base64,");
      background-size: 30px auto;
    }
    .starability-result:after {
      background-image: url("data:image/png;base64,");
      background-size: 30px auto;
    }
  }

  .starability-slot {
    display: block;
    position: relative;
    width: 150px;
    min-height: 60px;
    padding: 0;
    border: none;
  }

  .starability-slot > input {
    position: absolute;
    margin-right: -100%;
    opacity: 0;
  }

  .starability-slot > input:checked ~ label,
  .starability-slot > input:focus ~ label {
    background-position: 0 0;
  }

  .starability-slot > input:checked + label,
  .starability-slot > input:focus + label {
    background-position: 0 -30px;
  }

  .starability-slot > input[disabled]:hover + label {
    cursor: default;
  }

  .starability-slot > input:not([disabled]):hover ~ label {
    background-position: 0 0;
  }

  .starability-slot > input:not([disabled]):hover + label {
    background-position: 0 -30px;
  }

  .starability-slot > input:not([disabled]):hover + label::before {
    opacity: 1;
  }

  .starability-slot > input:focus + label {
    outline: 1px dotted #999;
  }

  .starability-slot .starability-focus-ring {
    position: absolute;
    left: 0;
    width: 100%;
    height: 30px;
    outline: 2px dotted #999;
    pointer-events: none;
    opacity: 0;
  }

  .starability-slot > .input-no-rate:focus ~ .starability-focus-ring {
    opacity: 1;
  }

  .starability-slot > label {
    position: relative;
    display: inline-block;
    float: left;
    width: 30px;
    height: 30px;
    font-size: 0.1em;
    color: transparent;
    cursor: pointer;
    background-image: url("data:image/png;base64,");
    background-repeat: no-repeat;
    background-position: 0 -30px;
  }

  .starability-slot > label::before {
    content: "";
    position: absolute;
    display: block;
    height: 30px;
    background-image: url("data:image/png;base64,");
    background-position: 0 30px;
    pointer-events: none;
    opacity: 0;
  }

  .starability-slot > label:nth-of-type(5)::before {
    width: 120px;
    left: -120px;
  }

  .starability-slot > label:nth-of-type(4)::before {
    width: 90px;
    left: -90px;
  }

  .starability-slot > label:nth-of-type(3)::before {
    width: 60px;
    left: -60px;
  }

  .starability-slot > label:nth-of-type(2)::before {
    width: 30px;
    left: -30px;
  }

  .starability-slot > label:nth-of-type(1)::before {
    width: 0px;
    left: 0px;
  }

  @media screen and (-webkit-min-device-pixel-ratio: 2),
    screen and (min-resolution: 192dpi) {
    .starability-slot > label {
      background-image: url("data:image/png;base64,");
      background-size: 30px auto;
    }
  }

  @media screen and (-ms-high-contrast: active) {
    .starability-slot {
      width: auto;
    }
    .starability-slot > input {
      position: static;
      margin-right: 0;
      opacity: 1;
    }
    .starability-slot .input-no-rate {
      display: none;
    }
    .starability-slot > label {
      display: inline;
      float: none;
      width: auto;
      height: auto;
      font-size: 1em;
      color: inherit;
      background: none;
    }
    .starability-slot > label::before,
    .starability-slot > label::after {
      display: none;
    }
  }

  .starability-slot > input:checked ~ label,
  .starability-slot > input:hover ~ label,
  .starability-slot > input:focus ~ label {
    -webkit-transition: background-position 0.7s;
    transition: background-position 0.7s;
  }
</style>

<div class="listing-title">
  <p class="title" style="margin-left: -32px"><%= listing.title%></p>
</div>
<div class="property-info">
  <div class="property-images">
    <div class="col1"></div>
    <div class="col2">
      <div class="image-one"></div>
      <div class="image-two"></div>
    </div>
  </div>
  <div class="property-description">
    <p class="listing-desc"><%= listing.description %></p>
    <p class="listing-loc"><%= listing.location %> , <%= listing.country %></p>
    <div class="property-booking">
      <p class="rent-price">
        &#8377; <%= listing.price.toString().replace(/\B(?=(\d{3})+(?!\d))/g,
        ",") %> / night
      </p>

      <!-- Date selection inputs -->
      <div class="date-selection">
        <form method="post" action="/payment/create-checkout-session">
          <input type="hidden" name="listingId" value="<%= listing.id%>" />
          <input type="hidden" name="amount" value="<%= listing.price %>" />
          <input type="hidden" name="propertyName" value="<%= listing.title %>" />
          <input type="hidden" name="url" value="<%= listing.images[0].url %>" />
          <% if(currUser) {%> 
            <input type="hidden" name="userName" value="<%= currUser.username %>" />
            <input type="hidden" name="userEmail" value="<%= currUser.email %>" />
          <% } %>
          <label for="check-in">Check-in:</label>
          <input
            type="date"
            id="check-in"
            name="checkIn"
            class="date-input"
            required
          />

          <label for="check-out" class="mt-2">Check-out:</label>
          <input
            type="date"
            id="check-out"
            name="checkOut"
            class="date-input"
            required
          />
        </div>
        <% if(currUser) {%>
          <button type="submit" class="buy-btn" id="rentBtn">Book Now</button>
        <% } else { %> 
          <button type="submit" class="buy-btn" id="rentBtn" style="cursor: none; background-color: #CCC;" disabled>Book Now</button>
        <% } %>
      </form>
    </div>

    <div class="owner-info">
      <p class="owner-name">Hosted by <%= listing.owner.username %></p>
      <p class="owner-status">3 years hosting</p>
    </div>
    <div class="edt-dlt">
      <% if(currUser) { %> <% if(currUser._id.toString() ==
      listing.owner._id.toString()) { %>
      <form action="/listings/<%= listing.id %>/edit">
        <button class="edt-btn">Edit</button>
      </form>
      <form method="post" action="/listings/<%=listing._id%>?_method=DELETE">
        <button class="dlt-btn">Delete</button>
      </form>
      <% } %> <% } %>
    </div>
  </div>
</div>
<div class="bt-border"></div>

<!-- rating + map -->

<div class="map-rating">
  <div class="rtng-section">
    <div class="mb-3 me-3">
      <h4><b>Leave a Review</b></h4>
      <form
        action="/listings/<%= listing._id %>/review"
        method="POST"
        novalidate
        class="needs-validation"
      >
        <div class="mb-3 mt-3 p-0">
          <label class="form-label"><h4>Rating</h4></label>
          <fieldset class="starability-slot">
            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="No rating."
            />
            <input
              type="radio"
              id="first-rate1"
              name="review[rating]"
              value="1"
            />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input
              type="radio"
              id="first-rate2"
              name="review[rating]"
              value="2"
            />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input
              type="radio"
              id="first-rate3"
              name="review[rating]"
              value="3"
            />
            <label for="first-rate3" title="Average">3 stars</label>
            <input
              type="radio"
              id="first-rate4"
              name="review[rating]"
              value="4"
            />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input
              type="radio"
              id="first-rate5"
              name="review[rating]"
              value="5"
            />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>
        <div class="mb-3">
          <label for="comment">comment</label>
          <textarea
            id="comment"
            type="text"
            name="review[comment]"
            placeholder="Comment here..."
            cols="30"
            rows="5"
            class="form-control"
            required
          ></textarea>
          <div class="invalid-feedback">Please add some review</div>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
      </form>
    </div>
  </div>

  <div id="map"></div>
</div>
<div class="bt-border mt-4"></div>
<div class="allReviews">
  <h4 class="mt-2"><b>All Reviews</b></h4>
  <div class="row">
    <% for(review of listing.reviews) { %>
    <div class="card col-3 me-2 p-0 ms-2 mt-4">
      <div class="card-body">
        <h5 class="card-title"><%= review.author.username%></h5>
        <p class="starability-result" data-rating="<%= review.rating %>">
          Rated: stars
        </p>
        <p class="card-text"><%= review.comment %></p>
        <form
          method="POST"
          action="/listings/<%= listing.id%>/reviews/<%=review.id%>?_method=DELETE"
        >
          <% if(currUser) { %>
          <button class="btn btn-sm btn-dark">Delete</button>
          <% } %>
        </form>
      </div>
    </div>
    <% } %>
  </div>
</div>

<script>
  const rentBtn = document.getElementById("rentBtn");
  const form = document.querySelector("form");  
  const checkInInput = document.getElementById("check-in");
  const checkOutInput = document.getElementById("check-out");

  rentBtn.addEventListener("click", function () {
    if (!checkInInput.value || !checkOutInput.value) {
      alert("Please select both Check-in and Check-out dates.");
      return; // Stop the form submission
    }
    rentBtn.disabled = true;
    rentBtn.innerHTML = "Processing...";
    rentBtn.style.backgroundColor = "#ccc";
    rentBtn.style.cursor = "not-allowed";

    form.submit();

  });
</script>

<script src="https://unpkg.com/leaflet@1.9.3/dist/leaflet.js"></script>
<script>
  // Initialize the map and set default view
  var map = L.map("map").setView([51.505, -0.09], 5); // Default view of Europe
  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution:
      '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
  }).addTo(map);

  // Function to find and locate the city
  let city = "<%= listing.location%>";
  let geocodeUrl = `https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${city}`;

  fetch(geocodeUrl)
    .then((response) => response.json())
    .then((data) => {
      if (data.length > 0) {
        let lat = data[0].lat;
        let lon = data[0].lon;

        // Set the map view to the location
        map.setView([lat, lon], 13);

        // Add a marker at the location
        L.marker([lat, lon]).addTo(map).bindPopup(`<b>${city}</b>`).openPopup();
      } else {
        alert("City not found!");
      }
    })
    .catch((error) => console.log(error));
</script>
