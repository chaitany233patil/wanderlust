<% layout('layout/boilerplate')%>

<style>
  .signupform {
    margin-top: 100px;
  }
</style>

<div class="row signupform">
  <h3 class="col-6 offset-3">SignUp on Wanderlust</h3>
  <div class="col-6 offset-3">
    <form
      method="POST"
      action="/bfuoeuofnancsnajkcnowidnqndndalkxsk"
      class="needs-validation"
      novalidate
    >
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          name="username"
          id="username"
          placeholder="username"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">Looks good!</div>
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">email</label>
        <input
          name="email"
          id="email"
          placeholder="email"
          type="email"
          class="form-control"
          required
        />
        <div class="valid-feedback">Looks good!</div>
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">passworld</label>
        <input
          name="password"
          id="password"
          placeholder="password"
          type="password"
          class="form-control"
          required
        />
        <div class="valid-feedback">Looks good!</div>
      </div>
      <button class="btn btn-danger">SignUp</button>
    </form>
  </div>
</div>
